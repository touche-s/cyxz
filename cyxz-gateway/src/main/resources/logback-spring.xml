<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台输出，包含 traceId（从 MDC 读取） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{traceId:-}] [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 根日志级别 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 项目包日志级别 -->
    <logger name="com.cyxz" level="DEBUG"/>
    <!-- MyBatis SQL 日志（开发调试用，生产注释掉） -->
    <logger name="com.cyxz.auth.mapper" level="DEBUG"/>
    <logger name="com.cyxz.user.mapper" level="DEBUG"/>
    <logger name="com.cyxz.post.mapper" level="DEBUG"/>
    <logger name="com.cyxz.comment.mapper" level="DEBUG"/>
    <logger name="com.cyxz.circle.mapper" level="DEBUG"/>
    <logger name="com.cyxz.analytics.mapper" level="DEBUG"/>
</configuration>
