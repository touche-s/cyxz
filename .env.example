# ====================================
# Cyxz 微服务项目环境变量模板
# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore 中）
# ====================================

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Nacos
NACOS_SERVER_ADDR=127.0.0.1:8848

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=86400

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=cyxz

# Elasticsearch
ES_HOST=127.0.0.1
ES_PORT=9200

# AI 审核（DeepSeek，不填则自动放行）
# 注册地址：https://platform.deepseek.com
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
AUTO_PASS_WITHOUT_KEY=true

# 图像审核（通义千问 VL，不填则自动放行）
# 注册地址：https://dashscope.console.aliyun.com
QWEN_VL_API_KEY=
QWEN_VL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_VL_MODEL=qwen3.7-plus
