# ====================================
# Cyxz 微服务项目环境变量配置
# 复制此文件为 .env 并填入真实配置
# ====================================

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=你的数据库密码

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Nacos
NACOS_SERVER_ADDR=127.0.0.1:8848

# JWT
JWT_SECRET=请替换为至少32字符的随机密钥
JWT_EXPIRATION=86400

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=cyxz

# Elasticsearch
ES_HOST=127.0.0.1
ES_PORT=9200
