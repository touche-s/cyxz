# ====================================
# Cyxz 微服务项目环境变量配置
# 复制此文件为 .env 并填入真实配置
# ====================================

# Nacos (服务注册与配置中心)
NACOS_SERVER_ADDR=127.0.0.1:8848

# JWT (勿使用默认值)
JWT_SECRET=请替换为至少32字符的随机密钥
JWT_EXPIRATION=86400

# MySQL (各服务数据源密码，用户名默认 root)
DB_USERNAME=root
DB_PASSWORD=请替换为你的数据库密码

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO (对象存储，取代阿里云 OSS)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=请替换为你的minio访问密钥
MINIO_SECRET_KEY=请替换为你的minio密钥
MINIO_BUCKET_NAME=cyxz

# Elasticsearch
ES_HOST=127.0.0.1
ES_PORT=9200
