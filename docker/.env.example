# ============================================================
# Cyxz Docker 部署环境变量
# 复制本文件为 .env 并按需修改（.env 已在 .gitignore 中）
# ============================================================

# ===== 基础设施密码 =====
DB_PASSWORD=cyxz123456
REDIS_PASSWORD=
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=cyxz123456

# ===== JWT =====
JWT_SECRET=your-jwt-secret-change-me-in-production
JWT_EXPIRATION=86400

# ===== AI 审核（不填则自动放行） =====
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
AUTO_PASS_WITHOUT_KEY=true
QWEN_VL_API_KEY=
QWEN_VL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_VL_MODEL=qwen3.7-plus

# ===== 宿主机端口映射（按需修改避免冲突） =====
FRONTEND_PORT=80
GATEWAY_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_CONSOLE_PORT=15672
MINIO_CONSOLE_PORT=9001
NACOS_PORT=8848
ES_PORT=9200
